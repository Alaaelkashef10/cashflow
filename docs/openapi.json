            "type": "string"
          }
        }
      },
      "CategorizeResponse": {
        "required": [
          "category",
          "confidence",
          "source"
        ],
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "confidence": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "source": {
            "type": "string"
          }
        }
      },
      "CreateEntryRequest": {
        "required": [
          "type",
          "description",
          "amount",
          "date",
          "category",
          "aiSuggestedCategory"
