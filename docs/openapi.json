          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "date": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "category": {
            "type": [
