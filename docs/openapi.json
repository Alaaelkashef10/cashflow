      "EntryResponse": {
        "required": [
          "id",
          "scenarioId",
          "type",
          "description",
          "amount",
          "date",
          "category",
          "aiSuggestedCategory",
          "userCorrected"
        ],
        "type": "object",
        "properties": {
          "id": {
