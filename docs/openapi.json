  "components": {
    "schemas": {
      "AnonymousTypeOfstring": {
        "required": [
          "message"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CategorizeRequest": {
        "required": [
          "description"
        ],
        "type": "object",
        "properties": {
